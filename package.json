{
  "name": "@flowscripter/pluggable-io-framework",
  "version": "2.1.7",
  "description": "A pluggable source/sink IO framework using https://github.com/flowscripter/dynamic-plugin-framework",
  "keywords": [
    "bun",
    "io",
    "plugin",
    "streaming"
  ],
  "homepage": "https://github.com/flowscripter/pluggable-io-framework#readme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flowscripter/pluggable-io-framework.git"
  },
  "files": [
    "dist",
    "src",
    "index.ts",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test"
  },
  "dependencies": {
    "@flowscripter/dynamic-plugin-framework": "^2.3.2",
    "@flowscripter/pluggable-io-framework-api": "^3.1.6"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "typedocOptions": {
    "readme": "none",
    "exclude": [
      "tests/**"
    ]
  }
}
